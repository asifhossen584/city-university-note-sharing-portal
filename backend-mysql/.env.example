# Copy this file to ".env" and fill in your own values.
# Never commit your real .env file (it is in .gitignore).

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=notes_user
DB_PASSWORD=notes_pass
DB_NAME=notes_portal

# --- Server ---
PORT=3000

# Secret used to sign the session cookie. Use a long random string in production.
SESSION_SECRET=change-this-to-a-long-random-string

# --- Demo accounts (only used the first time you run `npm run seed`) ---
# Change these before seeding if you like. The passwords are stored in the
# database only as bcrypt hashes - never as plain text.
ADMIN_EMAIL=admin@city.edu
ADMIN_PASSWORD=Admin@123
STUDENT_PASSWORD=Student@123

# Set to false to seed only the admin account + the course catalogue
# (no sample students, notes or notices).
SEED_SAMPLES=true

# Show the password-reset code in the API answer (demo only).
# Set to false on a real website and connect an email service instead.
SHOW_RESET_CODE=true

# Only university emails may register (leave empty to allow any email).
# ALLOWED_EMAIL_DOMAIN=cityuniversity.edu.bd

# Origins allowed to call this API from a browser (comma-separated).
# Vite's dev server runs on http://localhost:5173 by default; VS Code Live
# Server uses 5500; `npx serve` and `python -m http.server` use 3000/8000.
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000
